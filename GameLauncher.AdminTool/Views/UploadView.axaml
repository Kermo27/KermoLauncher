<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.AdminTool.ViewModels"
             xmlns:conv="using:GameLauncher.UI.Shared.Converters"
             x:Class="GameLauncher.AdminTool.Views.UploadView"
             x:DataType="vm:UploadViewModel">

    <UserControl.Styles>
        <Style Selector="Border.Section">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Margin="20" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Stretch">
            <!-- ============ HEADER ============ -->
            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="{Binding L[Admin.Upload.Title]}" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding L[Admin.Upload.Subtitle]}"
                           FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <!-- ============ HELP ============ -->
            <Border Classes="Section" Padding="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding L[Admin.Upload.HelpTitle]}" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding L[Admin.Upload.Help1]}"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding L[Admin.Upload.Help2]}"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding L[Admin.Upload.Help3]}"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding L[Admin.Upload.Help4]}"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============ CREDENTIALS ============ -->
            <Border Classes="Section">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#128273;" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding L[Admin.Upload.Credentials]}" Classes="SectionTitle"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Admin.Upload.WebDavUrl]}" Classes="FieldLabel" Margin="0,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Classes="field"
                                 Text="{Binding NextcloudUrl}"
                                 Watermark="{Binding L[Admin.Upload.WebDavPlaceholder]}" Margin="0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[Admin.Upload.User]}" Classes="FieldLabel" Margin="0,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="field"
                                 Text="{Binding NextcloudUser}" Margin="0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L[Admin.Upload.Password]}" Classes="FieldLabel" Margin="0,8"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Classes="field"
                                 Text="{Binding NextcloudPassword}" PasswordChar="&#8226;" Margin="0,8"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ FILES ============ -->
            <Border Classes="Section">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#128193;" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding L[Admin.Upload.Files]}" Classes="SectionTitle"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Admin.Upload.Metadata]}" Classes="FieldLabel" Margin="0,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Classes="field" IsReadOnly="True"
                                 Text="{Binding $parent[UserControl].DataContext.GameEditor.GeneratedMetadataPath}"
                                 Margin="0,8"/>
                    </Grid>

                    <TextBlock Text="{Binding L[Admin.Upload.FilesHint]}"
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============ PROGRESS ============ -->
            <Border Classes="Section">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#11014;" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding L[Admin.Upload.ProgressTitle]}" Classes="SectionTitle"/>
                    </StackPanel>

                    <!-- Error banner -->
                    <Border CornerRadius="8" Padding="12,9"
                            Background="{DynamicResource DangerBrush}" Opacity="0.9"
                            IsVisible="{Binding ErrorText, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding ErrorText}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <ProgressBar Value="{Binding UploadProgress}" Minimum="0" Maximum="100" Height="10"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource TagBgBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding UploadProgress, StringFormat='{}{0:F0}%'}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="48"/>
                        <TextBlock Text="{Binding CurrentFileText}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}"
                               IsVisible="{Binding StatusText, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

                    <Button Content="{Binding L[Admin.Upload.Start]}" Classes="primary"
                            Command="{Binding UploadCommand}"
                            IsEnabled="{Binding IsNotUploading}"
                            HorizontalAlignment="Left" Padding="24,11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>