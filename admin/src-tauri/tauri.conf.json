{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KermoLauncher Admin",
  "version": "2.0.0",
  "identifier": "dev.kermo.admin",
  "build": {
    "beforeDevCommand": {
      "script": "npm run admin:dev",
      "cwd": "../.."
    },
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": {
      "script": "npm run admin:build",
      "cwd": "../.."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KermoLauncher Admin",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
