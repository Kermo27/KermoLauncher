<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.UI.ViewModels"
             x:Class="GameLauncher.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.Section">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Margin="20" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="860" HorizontalAlignment="Stretch">
            <!-- ============ HEADER ============ -->
            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="{Binding L[Settings.Title]}" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding L[Settings.Subtitle]}" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <!-- ============ NEXTCLOUD ============ -->
            <Border Classes="Section">
                <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#128451;" Classes="SectionTitle"/>
                    <TextBlock Text="{Binding L[Settings.Nextcloud.Title]}" Classes="SectionTitle"/>
                </StackPanel>

                    <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Settings.Nextcloud.ShareUrl]}" Classes="FieldLabel" Margin="0,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Classes="field"
                                 Text="{Binding ShareUrl}"
                                 Watermark="{Binding L[Settings.Nextcloud.ShareUrlPlaceholder]}" Margin="0,8"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="{Binding L[Settings.Nextcloud.TestConnection]}" Classes="ghost"
                                Command="{Binding TestConnectionCommand}"
                                Margin="10,8,0,8" Padding="14,7"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[Settings.Nextcloud.ShareToken]}" Classes="FieldLabel" Margin="0,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="field"
                                 Text="{Binding ShareToken}"
                                 Watermark="{Binding L[Settings.Nextcloud.ShareTokenPlaceholder]}" Margin="0,8"/>
                    </Grid>

                    <TextBlock Text="{Binding L[Settings.Nextcloud.SharedFolder]}"
                               IsVisible="{Binding HasShareUrl}"
                               FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============ FOLDERS ============ -->
            <Border Classes="Section">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#128193;" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding L[Settings.Folders.Title]}" Classes="SectionTitle"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Settings.Folders.Install]}" Classes="FieldLabel" Margin="0,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Classes="field"
                                 Text="{Binding InstallFolder}" IsReadOnly="True" Margin="0,8"
                                 Watermark="{Binding L[Settings.Folders.InstallPlaceholder]}"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="{Binding L[Settings.Browse]}" Classes="ghost"
                                Command="{Binding BrowseInstallFolderCommand}"
                                Margin="10,8,0,8" Padding="14,7"/>
                    </Grid>
                    <TextBlock Text="{Binding L[Settings.Folders.Hint]}"
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============ GENERAL ============ -->
            <Border Classes="Section">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#9881;" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding L[Settings.General.Title]}" Classes="SectionTitle"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="200,*">
                        <TextBlock Grid.Column="0" Text="{Binding L[Settings.General.MaxParallel]}" Classes="FieldLabel"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <NumericUpDown Value="{Binding MaxParallelDownloads}"
                                           Minimum="1" Maximum="8" Width="110"/>
                            <TextBlock Text="{Binding L[Settings.General.MaxParallelHint]}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Settings.General.AutoUpdate]}" Classes="FieldLabel"/>
                        <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding AutoUpdate}"
                                      HorizontalAlignment="Left"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="{Binding L[Settings.General.CheckUpdates]}"
                                Command="{Binding CheckForUpdatesCommand}" Classes="ghost"
                                HorizontalAlignment="Left" Padding="14,7" Margin="0,4,0,0"/>
                    </Grid>

                    <Grid ColumnDefinitions="200,*">
                        <TextBlock Grid.Column="0" Text="{Binding L[Settings.General.Theme]}" Classes="FieldLabel"/>
                        <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedIndex="{Binding SelectedThemeIndex}"/>
                    </Grid>

                    <Grid ColumnDefinitions="200,*">
                        <TextBlock Grid.Column="0" Text="{Binding L[Settings.General.Language]}" Classes="FieldLabel"/>
                        <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedIndex="{Binding SelectedLanguageIndex}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ WINE (Linux) ============ -->
            <Border Classes="Section" IsVisible="{Binding ShowWineSettings}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#127918;" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding L[Settings.Wine.Title]}" Classes="SectionTitle"/>
                    </StackPanel>
                    <TextBlock Text="{Binding L[Settings.Wine.Hint]}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <Grid ColumnDefinitions="200,*">
                        <TextBlock Grid.Column="0" Text="{Binding L[Settings.Wine.Enable]}" Classes="FieldLabel"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchWindowsGamesWithWine}"
                                      HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid ColumnDefinitions="200,*">
                        <TextBlock Grid.Column="0" Text="{Binding L[Settings.Wine.Command]}" Classes="FieldLabel"/>
                        <TextBox Grid.Column="1" Classes="field" Text="{Binding WineCommand}"
                                 Watermark="{Binding L[Settings.Wine.CommandPlaceholder]}"/>
                    </Grid>

                    <Grid ColumnDefinitions="200,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding L[Settings.Wine.Prefix]}" Classes="FieldLabel"/>
                        <TextBox Grid.Column="1" Classes="field" Text="{Binding WinePrefix}"
                                 Watermark="{Binding L[Settings.Wine.PrefixPlaceholder]}"/>
                        <Button Grid.Column="2" Classes="ghost" Margin="10,0,0,0" Padding="14,7"
                                Content="{Binding L[Settings.Browse]}"
                                Command="{Binding BrowseWinePrefixCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ SAVE ============ -->
            <Button Content="{Binding L[Settings.Save]}" Classes="primary"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Right" Padding="28,11"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>