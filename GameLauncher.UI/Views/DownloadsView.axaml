<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.UI.ViewModels"
             xmlns:conv="using:GameLauncher.UI.Converters"
             x:Class="GameLauncher.UI.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">

    <UserControl.Styles>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource TagBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{Binding L[Downloads.Title]}" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding L[Downloads.Subtitle]}" FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- ============ EMPTY STATE ============ -->
        <Border CornerRadius="10" Padding="40"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                IsVisible="{Binding Downloads.Length, Converter={x:Static conv:ObjectConverters.IsZero}}">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="&#11015;" FontSize="44" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding L[Downloads.EmptyTitle]}" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding L[Downloads.EmptyHint]}"
                           FontSize="12" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ============ DOWNLOADS GRID ============ -->
        <DataGrid ItemsSource="{Binding Downloads}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="None"
                  BorderThickness="1"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{Binding L[Downloads.ColumnGame]}" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="6"
                                        Background="{DynamicResource TagBgBrush}">
                                    <TextBlock Text="&#127918;" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GameId}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,1,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{Binding L[Downloads.ColumnProgress]}" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DownloadItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <ProgressBar Grid.Column="0" Value="{Binding Progress}" Minimum="0" Maximum="1"
                                             Height="8" VerticalAlignment="Center"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource TagBgBrush}"/>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Width="52"
                                           Text="{Binding Progress, StringFormat='{}{0:P0}'}"
                                           FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{Binding L[Downloads.ColumnSpeed]}" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DownloadItemViewModel">
                            <TextBlock Text="{Binding Speed, Converter={x:Static conv:ObjectConverters.BytesToMBps}}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{Binding L[Downloads.ColumnActions]}" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:DownloadItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="{Binding L[Downloads.Pause]}" FontSize="11" Padding="10,5" Classes="ghost"
                                        Command="{Binding $parent[UserControl].DataContext.PauseCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding CanPause}"/>
                                <Button Content="{Binding L[Downloads.Resume]}" FontSize="11" Padding="10,5" Classes="ghost"
                                        Command="{Binding $parent[UserControl].DataContext.ResumeCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding CanResume}"/>
                                <Button Content="{Binding L[Downloads.Cancel]}" FontSize="11" Padding="10,5" Classes="ghost"
                                        Command="{Binding $parent[UserControl].DataContext.CancelCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding CanCancel}"/>
                                <Button Content="{Binding L[Downloads.Remove]}" FontSize="11" Padding="10,5" Classes="ghost"
                                        Command="{Binding $parent[UserControl].DataContext.RemoveCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding CanRemove}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>