<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.AdminTool.ViewModels"
             xmlns:conv="using:GameLauncher.UI.Shared.Converters"
             x:Class="GameLauncher.AdminTool.Views.UploadView"
             x:DataType="vm:UploadViewModel">

    <UserControl.Styles>
        <Style Selector="Border.Section">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Margin="20" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Stretch">
            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="{Binding L[Admin.Upload.Title]}" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding L[Admin.Upload.Subtitle]}"
                           FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <Border Classes="Section" Padding="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding L[Admin.Upload.HelpTitle]}" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding L[Admin.Upload.Help1]}"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding L[Admin.Upload.Help2]}"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding L[Admin.Upload.Help3]}"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding L[Admin.Upload.Help4]}"
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Classes="Section">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#128193;" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding L[Admin.Upload.DestTitle]}" Classes="SectionTitle"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="150,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding L[Admin.Upload.DestFolder]}" Classes="FieldLabel"/>
                        <TextBox Grid.Column="1" Classes="field" Text="{Binding DestFolder}"
                                 Watermark="{Binding L[Admin.Upload.DestPlaceholder]}"/>
                        <Button Grid.Column="2" Classes="ghost" Margin="10,0,0,0" Padding="14,7"
                                Content="{Binding L[Admin.Editor.Browse]}"
                                Command="{Binding BrowseDestCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding L[Admin.Upload.DestHint]}"
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <Border Classes="Section">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#128196;" Classes="SectionTitle"/>
                        <TextBlock Text="{Binding L[Admin.Upload.DiffTitle]}" Classes="SectionTitle"/>
                    </StackPanel>

                    <Border CornerRadius="8" Padding="12,9"
                            Background="{DynamicResource DangerBrush}" Opacity="0.9"
                            IsVisible="{Binding ErrorText, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding ErrorText}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{Binding TotalsText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               IsVisible="{Binding HasCompared}"/>

                    <ItemsControl ItemsSource="{Binding Plans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameSyncRow">
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                                        Background="{DynamicResource TagBgBrush}">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Details}" FontSize="11" FontFamily="monospace"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   IsVisible="{Binding !IsUpToDate}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ProgressBar Value="{Binding UploadProgress}" Minimum="0" Maximum="100" Height="10"
                                 IsVisible="{Binding IsBusy}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource TagBgBrush}"/>
                    <TextBlock Text="{Binding CurrentFileText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}"
                               IsVisible="{Binding StatusText, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="{Binding L[Admin.Upload.Compare]}" Classes="ghost"
                                Command="{Binding CompareCommand}"
                                IsEnabled="{Binding IsIdle}"
                                Padding="20,10"/>
                        <Button Content="{Binding L[Admin.Upload.Start]}" Classes="primary"
                                Command="{Binding PublishCommand}"
                                IsEnabled="{Binding IsIdle}"
                                Padding="24,11"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
