<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameLauncher.UI.ViewModels"
        x:Class="GameLauncher.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Styles>
        <Style Selector="Button.NavButton">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.NavButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
        </Style>
        <Style Selector="Button.NavButton.active">
            <Setter Property="Background" Value="{DynamicResource NavActiveBgBrush}"/>
        </Style>
        <Style Selector="Button.NavButton.active TextBlock.NavLabel">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.ToastClose">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,-6,-8,-6"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.ToastClose:pointerover">
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Obramowanie toasta zależy od typu; kolory z motywu, nie z konwertera -->
        <Style Selector="Border.toast">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.toast.success">
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        </Style>
        <Style Selector="Border.toast.warning">
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="Border.toast.error">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Window.Styles>

    <Panel>
        <DockPanel>
            <!-- ============ SIDEBAR ============ -->
            <Border DockPanel.Dock="Left" Width="230" Background="{DynamicResource SidebarBgBrush}">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20,22,20,24">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="38" Height="38" CornerRadius="9"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#127918;" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="KermoLauncher" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding L[Sidebar.Subtitle]}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Version -->
                <Border DockPanel.Dock="Bottom" Padding="20,12">
                    <TextBlock Text="{Binding WindowVersion}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>

                <!-- Navigation -->
                <StackPanel Margin="12,0,12,0" Spacing="4">
                    <Button Classes="NavButton" Classes.active="{Binding IsLibraryActive}"
                            Command="{Binding ShowLibraryCommand}">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Grid.Column="0" Text="&#128218;" FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding L[Nav.Library]}" Classes="NavLabel"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Button>

                    <Button Classes="NavButton" Classes.active="{Binding IsSettingsActive}"
                            Command="{Binding ShowSettingsCommand}">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Grid.Column="0" Text="&#9881;" FontSize="15"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding L[Nav.Settings]}" Classes="NavLabel"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ MAIN CONTENT ============ -->
        <Border Background="{DynamicResource WindowBgBrush}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
        </DockPanel>

        <!-- ============ TOASTS ============ -->
        <ItemsControl ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="20" IsHitTestVisible="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ToastItemViewModel">
                    <Border MaxWidth="360" CornerRadius="10" Padding="14,10"
                            Classes="toast"
                            Classes.success="{Binding IsSuccess}"
                            Classes.warning="{Binding IsWarning}"
                            Classes.error="{Binding IsError}"
                            Background="{DynamicResource ToastBgBrush}"
                            BorderThickness="1"
                            BoxShadow="0 4 14 0 #33000000"
                            PointerPressed="OnToastPointerPressed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="ToastClose" Content="&#10005;"
                                    Command="{Binding CloseCommand}"/>
                            <ProgressBar DockPanel.Dock="Bottom" Height="3" Minimum="0" Maximum="100"
                                         Value="{Binding Progress}"
                                         Margin="0,9,0,0"
                                         IsVisible="{Binding IsProgressVisible}"/>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,8,0">
                                <TextBlock Grid.Column="0" FontSize="15" Margin="0,0,10,0"
                                           Text="{Binding Icon}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</Window>