<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:GameLauncher.UI.ViewModels"
             x:Class="GameLauncher.UI.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Styles>
        <Style Selector="Border.GameCard">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.GameCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BoxShadow" Value="0 3 12 0 #22000000"/>
        </Style>
        <Style Selector="Border.Skeleton">
            <Setter Property="Background" Value="{DynamicResource TagBgBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="Button.TagChip">
            <Setter Property="Background" Value="{DynamicResource TagBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Zaznaczony filtr jest stanem elementu, więc kolor bierze styl, nie konwerter -->
        <Style Selector="Button.TagChip.selected">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.TagChip.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- Plakietka statusu: kolory z motywu, dobierane klasą -->
        <Style Selector="Border.StatusPill">
            <Setter Property="Background" Value="{DynamicResource PillNeutralBgBrush}"/>
        </Style>
        <Style Selector="Border.StatusPill > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillNeutralFgBrush}"/>
        </Style>
        <Style Selector="Border.StatusPill.installed">
            <Setter Property="Background" Value="{DynamicResource PillInstalledBgBrush}"/>
        </Style>
        <Style Selector="Border.StatusPill.installed > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillInstalledFgBrush}"/>
        </Style>
        <Style Selector="Border.StatusPill.busy">
            <Setter Property="Background" Value="{DynamicResource PillBusyBgBrush}"/>
        </Style>
        <Style Selector="Border.StatusPill.busy > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillBusyFgBrush}"/>
        </Style>
        <Style Selector="Border.StatusPill.failed">
            <Setter Property="Background" Value="{DynamicResource PillFailedBgBrush}"/>
        </Style>
        <Style Selector="Border.StatusPill.failed > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PillFailedFgBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20">
        <!-- ============ HEADER ============ -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18" Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding L[Library.Title]}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CountText}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <TextBox Grid.Column="1" Classes="field" Margin="24,0,0,0"
                         Text="{Binding SearchText}"
                         Watermark="{Binding L[Library.SearchPlaceholder]}" Width="280" VerticalAlignment="Center"
                         VerticalContentAlignment="Center"/>

                <ComboBox Grid.Column="2" Margin="12,0,0,0" Width="150"
                          ItemsSource="{Binding SortOptions}"
                          SelectedIndex="{Binding SelectedSortIndex}"
                          VerticalAlignment="Center"/>

                <Button Grid.Column="3" Margin="12,0,0,0" Classes="ghost"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsRefreshing}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#8635;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding L[Library.Refresh]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <ProgressBar Grid.Column="4" Margin="12,0,0,0" Width="120"
                             IsVisible="{Binding IsRefreshing}"
                             IsIndeterminate="True" VerticalAlignment="Center"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagFilterViewModel">
                        <Button Classes="TagChip" Classes.selected="{Binding IsSelected}"
                                Content="{Binding Tag}"
                                Command="{Binding SelectCommand}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ============ ERROR BANNER ============ -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,14" CornerRadius="8" Padding="14,10"
                Background="{DynamicResource DangerBrush}" Opacity="0.9"
                IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding LoadError}" Foreground="White" FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ============ EMPTY STATE ============ -->
        <Border DockPanel.Dock="Top" CornerRadius="10" Padding="40"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Margin="8,0,8,0"
                IsVisible="{Binding HasNoGames}">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="&#128218;" FontSize="44" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding L[Library.EmptyTitle]}" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding L[Library.EmptyHint]}"
                           FontSize="12" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ============ NO FILTER RESULTS ============ -->
        <Border DockPanel.Dock="Top" CornerRadius="10" Padding="36"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                Margin="8,0,8,14"
                IsVisible="{Binding HasNoFilteredResults}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="&#128269;" FontSize="34" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding L[Library.NoResultsTitle]}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding L[Library.NoResultsMessage]}"
                           FontSize="12" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Classes="ghost" Content="{Binding L[Library.ClearFilters]}"
                        Command="{Binding ClearFiltersCommand}" Margin="0,6,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============ GAMES GRID ============ -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Szkielety: kolekcja jest pusta po zakończeniu ładowania, więc nic nie zostaje w drzewie -->
                <ItemsControl ItemsSource="{Binding SkeletonItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="288" ItemHeight="388"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:Object">
                            <Border Classes="GameCard" Width="268" Height="372">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border Grid.Row="0" Height="120" CornerRadius="8" Margin="0,0,0,10"
                                            Classes="Skeleton"/>
                                    <StackPanel Grid.Row="1" Spacing="8">
                                        <Border Height="24" Width="80" CornerRadius="4" Classes="Skeleton"/>
                                        <Border Height="16" Width="60" CornerRadius="4" Classes="Skeleton"/>
                                        <Border Height="12" Width="220" CornerRadius="4" Classes="Skeleton"/>
                                        <Border Height="12" Width="180" CornerRadius="4" Classes="Skeleton"/>
                                    </StackPanel>
                                    <Grid Grid.Row="2" ColumnDefinitions="118,118" RowDefinitions="Auto,Auto"
                                          Margin="0,6,0,0">
                                        <Border Grid.Row="0" Grid.Column="0" Height="40" CornerRadius="8"
                                                Margin="0,0,4,0" Classes="Skeleton"/>
                                        <Border Grid.Row="0" Grid.Column="1" Height="40" CornerRadius="8"
                                                Margin="4,0,0,0" Classes="Skeleton"/>
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="34"
                                                CornerRadius="8" Margin="0,4,0,0" Classes="Skeleton"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Prawdziwe karty: ItemsRepeater wirtualizuje, WrapPanel budował wszystkie naraz -->
                <ItemsRepeater IsVisible="{Binding !IsLoading}"
                               ItemsSource="{Binding FilteredGames}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="288" MinItemHeight="388"
                                           MinColumnSpacing="0" MinRowSpacing="0"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameItemViewModel">
                            <Border Classes="GameCard" Width="268" Height="372">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <!-- Cover -->
                                    <Border Grid.Row="0" Height="120" CornerRadius="8" Margin="0,0,0,10"
                                            Background="{DynamicResource TagBgBrush}" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding CoverImage}"
                                                   IsVisible="{Binding HasCover}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            <TextBlock Text="&#127918;" FontSize="44"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       IsVisible="{Binding !HasCover}"/>
                                            <!-- Status pill -->
                                            <Border Classes="StatusPill"
                                                    Classes.installed="{Binding IsStatusInstalled}"
                                                    Classes.busy="{Binding IsStatusBusy}"
                                                    Classes.failed="{Binding IsStatusFailed}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="8" CornerRadius="12" Padding="10,3">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Update available badge -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="8" CornerRadius="12" Padding="10,3"
                                                    Background="{DynamicResource AccentBrush}"
                                                    IsVisible="{Binding IsUpdateAvailable}">
                                                <TextBlock Text="{Binding L[Library.UpdateAvailable]}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <!-- Size badge -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Margin="8" CornerRadius="8" Padding="8,2"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    IsVisible="{Binding HasSizeText}">
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontSize="16"
                                                   FontWeight="Bold" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Version}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PlayTimeText}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       IsVisible="{Binding HasPlayTime}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding DescriptionText}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                                   MinHeight="46" Margin="0,1,0,1"/>
                                        <ItemsControl ItemsSource="{Binding Tags}" Height="24">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Border Background="{DynamicResource TagBgBrush}"
                                                            CornerRadius="10" Padding="9,3" Margin="0,0,5,5">
                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <Grid Grid.Row="2" Height="78" ColumnDefinitions="118,118"
                                          RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                                        <Button Grid.Row="0" Grid.Column="0" Classes="primary" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                                Content="{Binding L[Library.Install]}" FontSize="12.5" Padding="10,9"
                                                Command="{Binding InstallCommand}"
                                                IsVisible="{Binding CanInstall}"/>
                                        <Button Grid.Row="0" Grid.Column="0" Classes="ghost" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                                Content="{Binding L[Library.CancelDownload]}" FontSize="12.5" Padding="10,9"
                                                Command="{Binding CancelDownloadCommand}"
                                                IsVisible="{Binding CanCancelDownload}"/>
                                        <Button Grid.Row="0" Grid.Column="0" Classes="primary" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                                Content="{Binding L[Library.Update]}" FontSize="12.5" Padding="10,9"
                                                Command="{Binding UpdateCommand}"
                                                IsEnabled="{Binding CanUpdate}"
                                                IsVisible="{Binding IsUpdateAvailable}"/>
                                        <Button Grid.Row="0" Grid.Column="1" Classes="primary" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                                                Content="{Binding L[Library.Launch]}" FontSize="12.5" Padding="10,9"
                                                Command="{Binding LaunchCommand}"
                                                IsVisible="{Binding CanLaunch}"/>
                                        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="ghost"
                                                Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                                Content="{Binding L[Library.Uninstall]}" FontSize="12" Padding="10,7"
                                                Command="{Binding UninstallCommand}"
                                                IsVisible="{Binding CanUninstall}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
