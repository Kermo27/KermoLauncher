<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameLauncher.AdminTool.ViewModels"
             xmlns:conv="using:GameLauncher.UI.Shared.Converters"
             x:Class="GameLauncher.AdminTool.Views.GameEditorView"
             x:DataType="vm:GameEditorViewModel">

    <UserControl.Styles>
        <Style Selector="Border.Section">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.GameList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.GameList ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="ListBox.GameList ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource NavActiveBgBrush}"/>
        </Style>
        <Style Selector="ListBox.GameList ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20">
        <!-- ============ HEADER ============ -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding L[Admin.Editor.Title]}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding L[Admin.Editor.Subtitle]}"
                                   FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <TextBox Classes="field" Width="340" VerticalAlignment="Center"
                             Text="{Binding ScanFolderPath}"
                             Watermark="{Binding L[Admin.Editor.FolderPlaceholder]}"/>

                    <Button Classes="ghost" VerticalAlignment="Center"
                            Command="{Binding BrowseScanFolderCommand}"
                            Content="{Binding L[Admin.Editor.Browse]}"/>

                    <Button Classes="ghost" VerticalAlignment="Center"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={x:Static conv:ObjectConverters.Not}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#128269;" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L[Admin.Editor.Scan]}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="ghost" VerticalAlignment="Center"
                            Command="{Binding AddGameCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#10133;" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L[Admin.Editor.AddGame]}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="primary" VerticalAlignment="Center"
                            Command="{Binding GenerateMetadataCommand}"
                            IsEnabled="{Binding IsGenerating, Converter={x:Static conv:ObjectConverters.Not}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#128424;" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L[Admin.Editor.Generate]}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ProgressBar Width="90" IsIndeterminate="True" VerticalAlignment="Center"
                                 IsVisible="{Binding IsScanning}" />
                </StackPanel>

                <!-- Error banner -->
                <Border CornerRadius="8" Padding="12,9"
                        Background="{DynamicResource DangerBrush}" Opacity="0.9"
                        IsVisible="{Binding ErrorText, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding ErrorText}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Status line -->
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{DynamicResource SuccessBrush}"
                           IsVisible="{Binding StatusText, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid ColumnDefinitions="380,*">
            <!-- Games list -->
            <Border Grid.Column="0" Classes="Section" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10"
                               Text="{Binding GamesCountText}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ListBox Classes="GameList"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:GameMetadata">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Version}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Id}" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Classes="Section"
                    IsVisible="{Binding SelectedGame, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <ScrollViewer>
                    <StackPanel Spacing="10" DataContext="{Binding SelectedGame}">
                        <TextBlock Text="{Binding L[Admin.Editor.GameDetails]}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Grid ColumnDefinitions="150,*,150,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Admin.Editor.Id]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Classes="field" IsReadOnly="True"
                                     Text="{Binding Id}" Margin="0,6" Grid.ColumnSpan="3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[Admin.Editor.Name]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Classes="field"
                                     Text="{Binding Name}" Margin="0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding L[Admin.Editor.Version]}" Classes="FieldLabel" Margin="8,6,0,6"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Classes="field"
                                     Text="{Binding Version}" Margin="8,6,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L[Admin.Editor.Tags]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Classes="field"
                                     Text="{Binding TagsString}" Margin="0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding L[Admin.Editor.Dependencies]}" Classes="FieldLabel" Margin="8,6,0,6"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Classes="field"
                                     Text="{Binding DependenciesString}" Margin="8,6,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding L[Admin.Editor.Description]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Classes="field" Grid.ColumnSpan="3"
                                     Text="{Binding Description}" AcceptsReturn="True" Height="70" Margin="0,6"
                                     Watermark="{Binding L[Admin.Editor.DescriptionPlaceholder]}"/>
                        </Grid>

                        <TextBlock Text="{Binding L[Admin.Editor.Files]}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid ColumnDefinitions="150,*,150,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Admin.Editor.LocalFolder]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Classes="field" IsReadOnly="True"
                                     Text="{Binding LocalFolder}" Margin="0,6" Grid.ColumnSpan="3"
                                     Watermark="{Binding L[Admin.Editor.LocalFolderPlaceholder]}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[Admin.Editor.ManifestUrl]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Classes="field" IsReadOnly="True"
                                     Text="{Binding ManifestUrl}" Margin="0,6" Grid.ColumnSpan="3"
                                     Watermark="{Binding L[Admin.Editor.ManifestUrlPlaceholder]}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L[Admin.Editor.Screenshots]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Classes="field" IsReadOnly="True"
                                     Text="{Binding ScreenshotCountText}"
                                     Margin="0,6"/>
                        </Grid>

                        <TextBlock Text="{Binding L[Admin.Editor.Launch]}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid ColumnDefinitions="150,*,150,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Admin.Editor.LaunchExecutable]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Classes="field"
                                     Text="{Binding LaunchExecutable}" Margin="0,6"
                                     Watermark="{Binding L[Admin.Editor.LaunchExecutablePlaceholder]}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding L[Admin.Editor.LaunchWorkingDir]}" Classes="FieldLabel" Margin="8,6,0,6"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Classes="field"
                                     Text="{Binding LaunchWorkingDir}" Margin="8,6,0,6"
                                     Watermark="{Binding L[Admin.Editor.Optional]}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[Admin.Editor.LaunchArgs]}" Classes="FieldLabel" Margin="0,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Classes="field"
                                     Text="{Binding LaunchArgsString}" Margin="0,6"
                                     Watermark="{Binding L[Admin.Editor.LaunchArgsPlaceholder]}"/>
                        </Grid>

                        <Border Margin="0,12,0,0" CornerRadius="8" Padding="12"
                                Background="{DynamicResource TagBgBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L[Admin.Editor.ScreenshotsTitle]}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding ScreenshotPaths}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="130" Height="86" CornerRadius="6" Margin="0,0,8,0"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding}" FontSize="9" Margin="6"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Button Classes="ghost" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Command="{Binding $parent[UserControl].DataContext.RemoveGameCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#128465;" FontSize="13"/>
                                <TextBlock Text="{Binding L[Admin.Editor.RemoveGame]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Empty state -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                        IsVisible="{Binding SelectedGame, Converter={x:Static conv:ObjectConverters.IsNull}}">
                <TextBlock Text="&#128269;" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding L[Admin.Editor.SelectHint]}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding L[Admin.Editor.SelectHint2]}"
                           FontSize="11" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>